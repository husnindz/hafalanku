  "ayahs": [
    { "surahNumber": 1, "ayahNumber": 1, "globalAyahNumber": 1, "juzNumber": 1, "pageNumberMsi": 1, "textUthmaniMsi": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ", "translationId": "Dengan nama Allah Yang Maha Pengasih, Maha Penyayang." },
    { "surahNumber": 1, "ayahNumber": 2, "globalAyahNumber": 2, "juzNumber": 1, "pageNumberMsi": 1, "textUthmaniMsi": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ", "translationId": "Segala puji bagi Allah, Tuhan seluruh alam," },
    { "surahNumber": 1, "ayahNumber": 3, "globalAyahNumber": 3, "juzNumber": 1, "pageNumberMsi": 1, "textUthmaniMsi": "الرَّحْمَٰنِ الرَّحِيمِ", "translationId": "Yang Maha Pengasih, Maha Penyayang," },
    { "surahNumber": 1, "ayahNumber": 4, "globalAyahNumber": 4, "juzNumber": 1, "pageNumberMsi": 1, "textUthmaniMsi": "مَالِكِ يَوْمِ الدِّينِ", "translationId": "Pemilik hari pembalasan." },
    { "surahNumber": 1, "ayahNumber": 5, "globalAyahNumber": 5, "juzNumber": 1, "pageNumberMsi": 1, "textUthmaniMsi": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ", "translationId": "Hanya kepada Engkaulah kami menyembah dan hanya kepada Engkaulah kami mohon pertolongan." },
    { "surahNumber": 1, "ayahNumber": 6, "globalAyahNumber": 6, "juzNumber": 1, "pageNumberMsi": 1, "textUthmaniMsi": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ", "translationId": "Tunjukilah kami jalan yang lurus," },
    { "surahNumber": 1, "ayahNumber": 7, "globalAyahNumber": 7, "juzNumber": 1, "pageNumberMsi": 1, "textUthmaniMsi": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ", "translationId": "(yaitu) jalan orang-orang yang telah Engkau beri nikmat kepadanya; bukan (jalan) mereka yang dimurkai, dan bukan (pula jalan) mereka yang sesat." },

    { "surahNumber": 103, "ayahNumber": 1, "globalAyahNumber": 6177, "juzNumber": 30, "pageNumberMsi": 601, "textUthmaniMsi": "وَالْعَصْرِ", "translationId": "Demi masa," },
    { "surahNumber": 103, "ayahNumber": 2, "globalAyahNumber": 6178, "juzNumber": 30, "pageNumberMsi": 601, "textUthmaniMsi": "إِنَّ الْإِنسَانَ لَفِي خُسْرٍ", "translationId": "sesungguhnya manusia itu benar-benar berada dalam kerugian," },
    { "surahNumber": 103, "ayahNumber": 3, "globalAyahNumber": 6179, "juzNumber": 30, "pageNumberMsi": 601, "textUthmaniMsi": "إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ", "translationId": "kecuali orang-orang yang beriman dan mengerjakan kebajikan serta saling menasihati untuk kebenaran dan saling menasihati untuk kesabaran." },

    { "surahNumber": 108, "ayahNumber": 1, "globalAyahNumber": 6205, "juzNumber": 30, "pageNumberMsi": 602, "textUthmaniMsi": "إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ", "translationId": "Sungguh, Kami telah memberimu (Muhammad) nikmat yang banyak." },
    { "surahNumber": 108, "ayahNumber": 2, "globalAyahNumber": 6206, "juzNumber": 30, "pageNumberMsi": 602, "textUthmaniMsi": "فَصَلِّ لِرَبِّكَ وَانْحَرْ", "translationId": "Maka laksanakanlah salat karena Tuhanmu, dan berkurbanlah!" },
    { "surahNumber": 108, "ayahNumber": 3, "globalAyahNumber": 6207, "juzNumber": 30, "pageNumberMsi": 602, "textUthmaniMsi": "إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ", "translationId": "Sungguh, orang-orang yang membencimu dialah yang terputus (dari rahmat Allah)." },

    { "surahNumber": 112, "ayahNumber": 1, "globalAyahNumber": 6222, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "قُلْ هُوَ اللَّهُ أَحَدٌ", "translationId": "Katakanlah (Muhammad), Dialah Allah, Yang Maha Esa." },
    { "surahNumber": 112, "ayahNumber": 2, "globalAyahNumber": 6223, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "اللَّهُ الصَّمَدُ", "translationId": "Allah tempat meminta segala sesuatu." },
    { "surahNumber": 112, "ayahNumber": 3, "globalAyahNumber": 6224, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "لَمْ يَلِدْ وَلَمْ يُولَدْ", "translationId": "(Allah) tidak beranak dan tidak pula diperanakkan." },
    { "surahNumber": 112, "ayahNumber": 4, "globalAyahNumber": 6225, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ", "translationId": "Dan tidak ada sesuatu yang setara dengan Dia." },

    { "surahNumber": 113, "ayahNumber": 1, "globalAyahNumber": 6226, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ", "translationId": "Katakanlah, Aku berlindung kepada Tuhan yang menguasai subuh (fajar)," },
    { "surahNumber": 113, "ayahNumber": 2, "globalAyahNumber": 6227, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "مِن شَرِّ مَا خَلَقَ", "translationId": "dari kejahatan (makhluk yang) Dia ciptakan," },
    { "surahNumber": 113, "ayahNumber": 3, "globalAyahNumber": 6228, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "translationId": "dan dari kejahatan malam apabila telah gelap gulita," },
    { "surahNumber": 113, "ayahNumber": 4, "globalAyahNumber": 6229, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ", "translationId": "dan dari kejahatan (perempuan-perempuan) penyihir yang meniup pada buhul-buhul (talinya)," },
    { "surahNumber": 113, "ayahNumber": 5, "globalAyahNumber": 6230, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "translationId": "dan dari kejahatan orang yang dengki apabila dia dengki." },

    { "surahNumber": 114, "ayahNumber": 1, "globalAyahNumber": 6231, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ", "translationId": "Katakanlah, Aku berlindung kepada Tuhannya manusia," },
    { "surahNumber": 114, "ayahNumber": 2, "globalAyahNumber": 6232, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "مَلِكِ النَّاسِ", "translationId": "Raja manusia," },
    { "surahNumber": 114, "ayahNumber": 3, "globalAyahNumber": 6233, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "إِلَٰهِ النَّاسِ", "translationId": "sembahan manusia," },
    { "surahNumber": 114, "ayahNumber": 4, "globalAyahNumber": 6234, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ", "translationId": "dari kejahatan (bisikan) setan yang bersembunyi," },
    { "surahNumber": 114, "ayahNumber": 5, "globalAyahNumber": 6235, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ", "translationId": "yang membisikkan (kejahatan) ke dalam dada manusia," },
    { "surahNumber": 114, "ayahNumber": 6, "globalAyahNumber": 6236, "juzNumber": 30, "pageNumberMsi": 604, "textUthmaniMsi": "مِنَ الْجِنَّةِ وَالنَّاسِ", "translationId": "dari (golongan) jin dan manusia." }
  ]
}

