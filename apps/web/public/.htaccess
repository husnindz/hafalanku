<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan rewrite file atau folder fisik yang benar-benar ada
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Arahkan seluruh route SPA ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .onnx
  AddType application/json .json
  AddType audio/mpeg .mp3
  AddType audio/wav .wav
</IfModule>

<IfModule mod_headers.c>
  # Pastikan index.html tidak dicache agresif agar rilis baru langsung terbaca
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Aset versioned, model ONNX, dan WASM dicache jangka panjang dan izinkan CORS
  <FilesMatch "\.(js|css|wasm|onnx|woff2|json)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

