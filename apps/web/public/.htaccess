<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan rewrite file atau folder fisik yang benar-benar ada
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Arahkan seluruh route SPA ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Pastikan index.html tidak dicache agresif agar rilis baru langsung terbaca
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Aset versioned & model ONNX dicache jangka panjang
  <FilesMatch "\.(js|css|wasm|onnx|woff2|json)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

